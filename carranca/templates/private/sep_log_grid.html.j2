{% set dlg_cls_size= 'modal-lg' %}

{% extends "./layouts/grid.html.j2" %}


{# ╒════════════════ Grid Footer ════════════════╕ #}
{% block grid_blc_footer %}

{% from "includes/_action_forms_and_btns.html.j2" import btn_close_dlg %}
<div class="col-auto">
    {{ btn_close_dlg(dlg_post_form_id, dlg_close_btn_id, grdBtnBack) }}
</div>
{% endblock grid_blc_footer %}
{# ╘═══════════════ Grid Footer ═════════════════╛ #}

{# ╒════════════════ Grid Forms ═════════════════╕ #}
{% block grid_blc_forms %}

{% from "includes/_action_forms_and_btns.html.j2" import action_form__post_cargo %}
{{ action_form__post_cargo(dlg_post_form_id, dlg_goto_action_url, dlg_data_wait_process, sec_msg=dlg_post_sec_msg) }}

{% endblock grid_blc_forms %}
{# ╘════════════════ Grid Forms ═════════════════╛ #}

{# ╒══════════════ Grid JavaScript ══════════════╕ #}
{% block grid_blc_javascript %}

<script>
    const colMeta = {{ grid_col_meta | tojson | safe }};
    const gridRows = {{ log_data | tojson | safe }};
    const gridID = '{{ grid_id }}';
    const userLocale = '{{ userLocale }}';

</script>
<script src="{{static_route('js/sep_log_grid.js')}}"></script>

{% endblock grid_blc_javascript %}
{# ╘══════════════ Grid JavaScript ══════════════╛ #}

{# eof #}
