{# ------------------------------------
./includes/backend-msg.html.j2
---------------------------------

Displays HTML messages (Prompt, Error, Warn, Success, Info, Technical)
Hierarchy: most severe first. Prompt is not a severity, it's a question —
rendered with no color and no icon, see UIDBTexts.set_msg_prompt().
See carranca\common\UITextsKeys.py

mgd
--------------------------------------- #}
{# cSpell:ignore #}


{% if msgPrompt or msgInfo or msgWarn or msgError or msgSuccess or msgTech %}
{# ╒═════════════════ Display if Any Message Available ═════════════════╕ #}
<div class="text-center text-md-center">
    <h6 class="font-weight-normal">

        {% set first_msg = True %}

        {# ┄┄┄┄┄ Prompt ┄┄┄┄┄ #}
        {% if msgPrompt %}
        <div class="alert backend-msg-alert {% if not first_msg %}mt-1{% endif %} mb-0">
            <div>{{ msgPrompt | safe }}</div>
        </div>
        {% set first_msg = False %}
        {% endif %}

        {# ┄┄┄┄┄ Error ┄┄┄┄┄ #}
        {% if msgError %}
        <div class="alert alert-danger backend-msg-alert {% if not first_msg %}mt-1{% endif %} mb-0">
            <i class="backend-msg-icon {{ fi.style }} {{ fi.error }} me-1" aria-hidden="true"></i>
            <div>{{ msgError | safe }}</div>
        </div>
        {% set first_msg = False %}
        {% endif %}

        {# ┄┄┄┄┄ Warning ┄┄┄┄┄ #}
        {% if msgWarn %}
        <div class="alert alert-warning backend-msg-alert {% if not first_msg %}mt-1{% endif %} mb-0">
            <i class="backend-msg-icon {{ fi.style }} {{ fi.warn }} me-1" aria-hidden="true"></i>
            <div>{{ msgWarn | safe }}</div>
        </div>
        {% set first_msg = False %}
        {% endif %}

        {# ┄┄┄┄┄ Success ┄┄┄┄┄ #}
        {% if msgSuccess %}
        <div class="alert alert-success backend-msg-alert {% if not first_msg %}mt-1{% endif %} mb-0">
            <i class="backend-msg-icon {{ fi.style }} {{ fi.success }} me-1" aria-hidden="true"></i>
            <div>{{ msgSuccess | safe }}</div>
        </div>
        {% set first_msg = False %}
        {% endif %}

        {# ┄┄┄┄┄ Information ┄┄┄┄┄ #}
        {% if msgInfo %}
        <div class="alert alert-info backend-msg-alert {% if not first_msg %}mt-1{% endif %} mb-0">
            <i class="backend-msg-icon {{ fi.style }} {{ fi.info }} me-1" aria-hidden="true"></i>
            <div>{{ msgInfo | safe }}</div>
        </div>
        {% set first_msg = False %}
        {% endif %}

        {# ┄┄┄┄┄ Technical ┄┄┄┄┄ #}
        {% if msgTech %}
        <div class="alert alert-dark backend-msg-alert {% if not first_msg %}mt-1{% endif %} mb-0">
            <i class="backend-msg-icon {{ fi.style }} {{ fi.tech }} me-1" aria-hidden="true"></i>
            <div>{{ msgTech | safe }}</div>
        </div>
        {% set first_msg = False %}
        {% endif %}

    </h6>
</div>
{# ╘═════════════════ Display if Any Message Available ═════════════════╛ #}

{% endif %}

{# eof #}
