{# --
The default caption buttons are in English:
    it is understandable for the user and
    also indicates that
    the button is awaiting a value from the developer.
-- #}

{# -- Post form: includes security token & cargo --
   `extra`: raw HTML attributes appended to the <form ...> tag (eg onsubmit=...)
   `sec_msg`: security-token context-binding message  value, passed to safe_token.value( #}
{% macro action_form__post_cargo(form_id, action_route, dlg_wait_process, extra='', sec_msg='')%}
<form id="{{form_id}}" method="post" action="{{action_route}}" {{dlg_wait_process}} {{extra}}>
    <input type="hidden" name="{{safe_token.cargo}}" id="{{safe_token.cargo}}">
    <input type="hidden" name="{{safe_token.key}}" value="{{safe_token.value(sec_msg)}}">
</form>
{% endmacro %}


{# -- Close Button: [x] of layouts/dialog.html.j2 -- #}
{% macro btn_close_dlg(form_id, btn_id, caption, extra='') %}
<button type="submit" form="{{form_id}}" id="{{btn_id}}" class="frm-foot-btn" {{extra}}>
    {{caption | default('Close')}}
</button>
{% endmacro %}


{# -- Submit Button of form with ID form_id -- #}
{% macro btn_submit(form_id, btn_id, caption, extra='') %}
<button type="submit" form="{{form_id}}" id="{{btn_id}}" class="frm-foot-btn" {{extra}}>
    {{caption | default('Save')}}
</button>
{% endmacro %}


{# -- Button to linked through ui_constant, creates it 'own' ID -- #}
{% macro btn_action(form_id, caption, cmd= '', extra= '')%}
<button type="submit" form="{{form_id}}" id="{{do_btn_id(cmd, caption)}}" class="frm-foot-btn" {{extra}}>
    {{caption}}
</button>
{% endmacro %}
{# -- Button #}


{# -- Download button: same as btn_action, but with the new-tab + sleep-veil wiring
   (formtarget="_blank" onclick="setSleepVeil()", see canoa.js's download_ready cookie
   trick) baked in, so callers don't repeat that attribute string per grid -- #}
{% macro btn_download(form_id, caption, cmd= '', extra= '')%}
<button type="submit" form="{{form_id}}" id="{{do_btn_id(cmd, caption)}}" class="frm-foot-btn" formtarget="_blank" onclick="setSleepVeil()" {{extra}}>
    {{caption}}
</button>
{% endmacro %}


{# -- Button that calls a JS function directly on click, not tied to a form submission
   (eg. a grid-row action gated on selection: download, etc.) -- #}
{% macro btn_click(btn_id, caption, onclick, extra='') %}
<button type="button" onclick="{{onclick}}" id="{{btn_id}}" class="frm-foot-btn" {{extra}}>
    {{caption}}
</button>
{% endmacro %}

{# eof #}