{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    // Reloader: FLASK_RUN_RELOAD below (1 = reload on file changes, 0 = off, as on the server)
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Canoa",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "module": "flask",
            "cwd": "${workspaceFolder}/carranca",
            "env": {
                "FLASK_APP": "main.py",
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1",
                "FLASK_RUN_RELOAD": "0",
                "CANOA_DEBUG": "True",
                "CANOA_APP_MODE": "Development",
                "CANOA_DISPLAY_MUTE": "False",
            },
            "args": [
                "run",
                "--no-debugger",
            ],
            "jinja": true,
            "justMyCode": true,
        },
        {
            "name": "Run spd_analysis test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/carranca/internal_tests/gpkg_view.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        }
    ]
}