@echo off
rem fake data_validate for Windows dev -- production runs run_validate.sh (real validator). Don't delete.
rem %5 = output folder, see run_validator.py's run_command
rem "tests": 1 => validated = true; use 0 (or skip the pdf) to simulate a failed validation
rem submit.py rejects reports under 200 bytes, so pad it
(
  echo %%PDF-1.4 fake report
  echo Canoa: fake data_validate report, generated by run_validate.bat on Windows dev.
  echo It only exists so submit.py finds a report and the revalidation flow can continue.
  echo Not a real PDF. Not a real validation.
) > "%~5\data_report.pdf"
echo ^<{"data_validate": {"version": "0.0.0-fake", "report": {"errors": 0, "warnings": 0, "tests": 1}}}^>
exit /b 0
